# ------------------------------------------------------------------------------
# GeoLens - Environment Variables Template
# ------------------------------------------------------------------------------
# Instructions:
# 1. Copy this file and rename it to .env in the root directory.
# 2. Replace the placeholder values with your actual configuration.
# 3. DO NOT commit the .env file to version control.
# ------------------------------------------------------------------------------

# --- Backend Configuration ---
PORT=5000

# Google Earth Engine Project ID (Required)
# Your Google Cloud project ID registered for Google Earth Engine.
GEE_PROJECT_ID=geolens-earth-engine

# Google Earth Engine Service Account Key JSON (Required in Production)
# Full raw JSON content of the Google Cloud service-account key.
# This is a secret and must never be committed to Git.
GEE_SERVICE_ACCOUNT_JSON=

# GROQ API Key for Orbit AI Analysis
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# Allowed Origin for CORS (e.g., https://your-app.vercel.app or *)
ALLOWED_ORIGIN=*

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:5000
