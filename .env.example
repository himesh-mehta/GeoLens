# ------------------------------------------------------------------------------
# SolveNest - Environment Variables Template
# ------------------------------------------------------------------------------
# Instructions:
# 1. Copy this file and rename it to .env in the root directory.
# 2. Replace the placeholder values with your actual configuration.
# 3. DO NOT commit the .env file to version control.
# ------------------------------------------------------------------------------

# --- Backend Configuration ---
# Port for the Flask Backend API (default is 5000)
PORT=5000

# Google Earth Engine Project ID for authentication and data polling
# Example: solvenest-earth-engine
GEE_PROJECT_ID=YOUR_GEE_PROJECT_ID_HERE

# GROQ API Key for GPT-OSS AI Analysis
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# --- Frontend Configuration ---
# API URL for the Next.js frontend to communicate with the Flask backend.
NEXT_PUBLIC_API_URL=http://localhost:5000
